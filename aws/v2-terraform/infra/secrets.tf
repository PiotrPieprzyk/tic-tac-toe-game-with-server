# Database passwords, generated by Terraform and stored as SSM SecureStrings. The values never
# reach the Terraform state:
#   - `ephemeral` resources produce a value for the current run only; it isn't saved anywhere.
#   - `value_wo` ("write-only") sends the value to AWS but doesn't record it in state.
#     Terraform only knows `value_wo_version`; bumping it (variables.tf) writes a new value.
#
# The ephemeral generator makes a NEW random value on every run, but it's only written when the
# version changes, so existing passwords stay as they are.

ephemeral "random_password" "db_master" {
  length = 32
  # Alphanumeric only: RDS rejects / @ " and space, and URL-special characters would break DATABASE_URL.
  special = false
}

ephemeral "random_password" "db_app" {
  length  = 32
  special = false
}

resource "aws_ssm_parameter" "db_password" {
  name             = local.params.db_password
  description      = "RDS master password"
  type             = "SecureString"
  value_wo         = ephemeral.random_password.db_master.result
  value_wo_version = var.db_password_version
}

resource "aws_ssm_parameter" "db_app_password" {
  name             = local.params.db_app_password
  description      = "Password of the least-privilege app role (applied by the db-grants container)"
  type             = "SecureString"
  value_wo         = ephemeral.random_password.db_app.result
  value_wo_version = var.db_app_password_version
}

# Reads the master password back from SSM for RDS (database.tf), so SSM is the single source
# of truth. Referencing the ARN makes Terraform open this only after the parameter is written.
ephemeral "aws_ssm_parameter" "db_password" {
  arn             = aws_ssm_parameter.db_password.arn
  with_decryption = true
}
