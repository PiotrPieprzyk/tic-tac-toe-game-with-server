# Copy to .env to override defaults used by docker-compose.yml.

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tic_tac_toe
POSTGRES_TEST_DB=tic_tac_toe_test
POSTGRES_PORT=5432

# Frontend — must be reachable from the browser, not just from inside the
# frontend container, so `backend` (the docker-compose service name) won't
# work here. Use the backend's host-mapped port instead.
VITE_API_DOMAIN=http://localhost:3000
